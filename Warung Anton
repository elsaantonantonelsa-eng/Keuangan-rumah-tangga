<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Warung POS</title>

<style>
*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,Helvetica,sans-serif;
    background:#f3f5f7;
    color:#202124;
}

header{
    background:#1769aa;
    color:white;
    padding:15px;
    position:sticky;
    top:0;
    z-index:100;
}

.header-inner{
    max-width:1100px;
    margin:auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

header h1{
    margin:0;
    font-size:21px;
}

.container{
    max-width:1100px;
    margin:auto;
    padding:15px;
}

nav{
    background:white;
    padding:8px;
    display:flex;
    gap:7px;
    overflow-x:auto;
    position:sticky;
    top:56px;
    z-index:90;
    border-bottom:1px solid #ddd;
}

nav button{
    border:0;
    padding:10px 14px;
    border-radius:8px;
    background:#edf1f4;
    white-space:nowrap;
    cursor:pointer;
}

nav button.active{
    background:#1769aa;
    color:white;
}

.page{
    display:none;
}

.page.active{
    display:block;
}

.card{
    background:white;
    padding:16px;
    border-radius:12px;
    margin-bottom:15px;
    box-shadow:0 2px 8px rgba(0,0,0,.06);
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
    gap:12px;
}

.stat{
    font-size:14px;
}

.stat strong{
    display:block;
    font-size:22px;
    margin-top:8px;
}

input,select{
    width:100%;
    padding:11px;
    border:1px solid #ccd2d8;
    border-radius:8px;
    margin:5px 0 10px;
    font-size:15px;
}

button{
    cursor:pointer;
}

.btn{
    border:0;
    padding:10px 14px;
    border-radius:8px;
    color:white;
}

.primary{
    background:#1769aa;
}

.success{
    background:#198754;
}

.danger{
    background:#dc3545;
}

.secondary{
    background:#68737d;
}

.row{
    display:flex;
    gap:8px;
}

.row > *{
    flex:1;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    padding:9px;
    border-bottom:1px solid #e5e7e9;
    text-align:left;
    font-size:13px;
}

.table-wrap{
    overflow-x:auto;
}

.badge{
    display:inline-block;
    padding:4px 7px;
    border-radius:10px;
    background:#dff4e5;
    color:#23743b;
}

.badge.low{
    background:#fff0cf;
    color:#966300;
}

.hidden{
    display:none!important;
}

#loginScreen{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:20px;
    background:#f3f5f7;
}

.login-box{
    background:white;
    width:100%;
    max-width:400px;
    padding:25px;
    border-radius:15px;
    box-shadow:0 5px 25px rgba(0,0,0,.1);
}

.login-box h2{
    text-align:center;
}

#scannerVideo{
    width:100%;
    max-height:320px;
    background:#111;
    border-radius:12px;
}

.scan-result{
    padding:15px;
    border:2px dashed #1769aa;
    border-radius:10px;
    margin-top:10px;
}

.cart-item{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:10px 0;
    border-bottom:1px solid #eee;
}

.empty{
    color:#777;
    text-align:center;
    padding:20px;
}

@media(max-width:600px){

    .container{
        padding:10px;
    }

    .row{
        flex-direction:column;
    }

    th,td{
        font-size:12px;
    }

}
</style>
</head>

