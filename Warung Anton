window.saveFinance = async function(){

    const type =
        document.getElementById(
            "financeType"
        ).value;


    const description =
        document.getElementById(
            "financeDescription"
        ).value.trim();


    const amount =
        Number(
            document.getElementById(
                "financeAmount"
            ).value
        );


    if(!amount){

        alert(
            "Jumlah wajib diisi."
        );

        return;

    }


    try{

        await addDoc(
            collection(db,"keuangan"),
            {

                jenis:type,

                keterangan:
                    description,

                jumlah:amount,

                tanggal:
                    serverTimestamp(),

                user:
                    auth.currentUser.email

            }
        );


        document.getElementById(
            "financeDescription"
        ).value = "";


        document.getElementById(
            "financeAmount"
        ).value = "";


        await loadFinance();


    }catch(error){

        alert(error.message);

    }

};


async function loadFinance(){

    const snapshot =
        await getDocs(
            collection(
                db,
                "keuangan"
            )
        );


    const rows = [];


    snapshot.forEach(docSnap => {

        rows.push({

            id:docSnap.id,

            ...docSnap.data()

        });

    });


    rows.sort(
        (a,b) =>
            getTime(b.tanggal)
            -
            getTime(a.tanggal)
    );


    document.getElementById(
        "financeTable"
    ).innerHTML =
        rows.map(item => `

<tr>

<td>
${formatDate(item.tanggal)}
</td>

<td>
${escapeHTML(item.jenis)}
</td>

<td>
${escapeHTML(item.keterangan)}
</td>

<td>
${formatRupiah(item.jumlah)}
</td>

<td>

<button
class="btn danger"
onclick="deleteFinance('${item.id}')">

Hapus

</button>

</td>

</tr>

`).join("");

}


window.deleteFinance =
async function(id){

    if(!confirm(
        "Hapus catatan keuangan?"
    )) return;


    await deleteDoc(
        doc(
            db,
            "keuangan",
            id
        )
    );


    await loadFinance();

};


// ======================================================
// TRANSAKSI
// ======================================================

let transactions = [];


async function loadTransactions(){

    const snapshot =
        await getDocs(
            collection(
                db,
                "transaksi"
            )
        );


    transactions = [];


    snapshot.forEach(docSnap => {

        transactions.push({

            id:docSnap.id,

            ...docSnap.data()

        });

    });


    transactions.sort(
        (a,b) =>
            getTime(b.tanggal)
            -
            getTime(a.tanggal)
    );


    renderTransactions();

    updateDashboard();

}


function renderTransactions(){

    document.getElementById(
        "transactionTable"
    ).innerHTML =
        transactions.map(t => `

<tr>

<td>
${formatDate(t.tanggal)}
</td>

<td>
${formatRupiah(t.total)}
</td>

<td>
${formatRupiah(t.modal)}
</td>

<td>
${formatRupiah(t.laba)}
</td>

</tr>

`).join("");

}


function updateDashboard(){

    const today =
        new Date()
            .toISOString()
            .slice(0,10);


    const todayTransactions =
        transactions.filter(t => {

            if(!t.tanggal)
                return false;

            const date =
                t.tanggal.toDate
                    ? t.tanggal.toDate()
                    : new Date(t.tanggal);

            return date
                .toISOString()
                .slice(0,10)
                ===
                today;

        });


    const sales =
        todayTransactions
            .reduce(
                (sum,t) =>
                    sum + Number(t.total || 0),
                0
            );


    const capital =
        todayTransactions
            .reduce(
                (sum,t) =>
                    sum + Number(t.modal || 0),
                0
            );


    document.getElementById(
        "todaySales"
    ).textContent =
        formatRupiah(sales);


    document.getElementById(
        "todayCapital"
    ).textContent =
        formatRupiah(capital);


    document.getElementById(
        "todayProfit"
    ).textContent =
        formatRupiah(
            sales-capital
        );


    const totalSales =
        transactions.reduce(
            (sum,t) =>
                sum + Number(t.total || 0),
            0
        );


    const totalCapital =
        transactions.reduce(
            (sum,t) =>
                sum + Number(t.modal || 0),
            0
        );


    document.getElementById(
        "reportSales"
    ).textContent =
        formatRupiah(totalSales);


    document.getElementById(
        "reportCapital"
    ).textContent =
        formatRupiah(totalCapital);


    document.getElementById(
        "reportProfit"
    ).textContent =
        formatRupiah(
            totalSales-totalCapital
        );

}


function getTime(timestamp){

    if(!timestamp)
        return 0;

    if(timestamp.toMillis)
        return timestamp.toMillis();

    if(timestamp.toDate)
        return timestamp.toDate().getTime();

    return new Date(timestamp).getTime();

}


function formatDate(timestamp){

    if(!timestamp)
        return "-";


    const date =
        timestamp.toDate
            ? timestamp.toDate()
            : new Date(timestamp);


    return date.toLocaleString(
        "id-ID"
    );

}

