<!-- FIREBASE -->

<script type="module">

import {
    initializeApp
} from "https://www.gstatic.com/firebasejs/11.0.2/firebase-app.js";

import {
    getAuth,
    signInWithEmailAndPassword,
    onAuthStateChanged,
    signOut
} from "https://www.gstatic.com/firebasejs/11.0.2/firebase-auth.js";

import {
    getFirestore,
    collection,
    addDoc,
    getDocs,
    getDoc,
    doc,
    setDoc,
    updateDoc,
    deleteDoc,
    query,
    orderBy,
    serverTimestamp,
    runTransaction
} from "https://www.gstatic.com/firebasejs/11.0.2/firebase-firestore.js";


// ======================================================
// GANTI DENGAN CONFIG FIREBASE KAMU
// ======================================================

const firebaseConfig = {

    apiKey: "GANTI_API_KEY",

    authDomain: "GANTI_PROJECT_ID.firebaseapp.com",

    projectId: "GANTI_PROJECT_ID",

    storageBucket: "GANTI_PROJECT_ID.firebasestorage.app",

    messagingSenderId: "GANTI_MESSAGING_SENDER_ID",

    appId: "GANTI_APP_ID"

};


// ======================================================

const app = initializeApp(firebaseConfig);

const auth = getAuth(app);

const db = getFirestore(app);


// ======================================================
// GLOBAL
// ======================================================

let products = [];

let cart = [];

let scannerStream = null;

let scannerRunning = false;


// ======================================================
// HELPER
// ======================================================

window.formatRupiah = function(number){

    return new Intl.NumberFormat(
        "id-ID",
        {
            style:"currency",
            currency:"IDR",
            maximumFractionDigits:0
        }
    ).format(number || 0);

};


function escapeHTML(value){

    return String(value || "")
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;")
        .replaceAll("'","&#039;");

}


// ======================================================
// AUTH
// ======================================================

window.login = async function(){

    const email =
        document.getElementById("loginEmail").value.trim();

    const password =
        document.getElementById("loginPassword").value;

    const error =
        document.getElementById("loginError");

    error.textContent = "";

    if(!email || !password){

        error.textContent =
            "Email dan password wajib diisi.";

        return;

    }

    try{

        await signInWithEmailAndPassword(
            auth,
            email,
            password
        );

    }catch(error){

        console.error(error);

        document.getElementById("loginError").textContent =
            "Login gagal. Periksa email dan password.";

    }

};


window.logout = async function(){

    await signOut(auth);

};


onAuthStateChanged(auth, async user => {

    if(user){

        document
            .getElementById("loginScreen")
            .classList.add("hidden");

        document
            .getElementById("app")
            .classList.remove("hidden");

        document
            .getElementById("userEmail")
            .textContent =
            user.email;

        await loadAll();

    }else{

        document
            .getElementById("loginScreen")
            .classList.remove("hidden");

        document
            .getElementById("app")
            .classList.add("hidden");

    }

});


// ======================================================
// NAVIGATION
// ======================================================

window.openPage = function(page,button){

    document
        .querySelectorAll(".page")
        .forEach(p =>
            p.classList.remove("active")
        );

    document
        .getElementById(page)
        .classList.add("active");


    document
        .querySelectorAll("nav button")
        .forEach(b =>
            b.classList.remove("active")
        );

    if(button){

        button.classList.add("active");

    }

    if(page !== "scanner"){

        stopScanner();

    }

};


// ======================================================
// LOAD SEMUA DATA
// ======================================================

async function loadAll(){

    await loadProducts();

    await loadFinance();

    await loadTransactions();

    updateDashboard();

}


// ======================================================
// BARANG
// ======================================================

window.saveProduct = async function(){

    const id =
        document.getElementById("productId").value;

    const data = {

        nama:
            document.getElementById("productName").value.trim(),

        barcode:
            document.getElementById("productBarcode").value.trim(),

        modal:
            Number(
                document.getElementById("productCapital").value
            ) || 0,

        jual:
            Number(
                document.getElementById("productPrice").value
            ) || 0,

        stok:
            Number(
                document.getElementById("productStock").value
            ) || 0,

        minStok:
            Number(
                document.getElementById("productMinStock").value
            ) || 0,

        updatedAt:
            serverTimestamp()

    };


    if(!data.nama){

        alert("Nama barang wajib diisi.");

        return;

    }


    try{

        if(id){

            await updateDoc(
                doc(db,"barang",id),
                data
            );

        }else{

            data.createdAt =
                serverTimestamp();

            await addDoc(
                collection(db,"barang"),
                data
            );

        }


        alert("Barang berhasil disimpan.");

        clearProductForm();

        await loadProducts();

    }catch(error){

        console.error(error);

        alert(
            "Gagal menyimpan barang: " +
            error.message
        );

    }

};


window.clearProductForm = function(){

    document.getElementById("productId").value = "";

    document.getElementById("productName").value = "";

    document.getElementById("productBarcode").value = "";

    document.getElementById("productCapital").value = "";

    document.getElementById("productPrice").value = "";

    document.getElementById("productStock").value = "";

    document.getElementById("productMinStock").value = "3";

};


window.editProduct = function(id){

    const product =
        products.find(p => p.id === id);

    if(!product) return;


    document.getElementById("productId").value =
        product.id;

    document.getElementById("productName").value =
        product.nama || "";

    document.getElementById("productBarcode").value =
        product.barcode || "";

    document.getElementById("productCapital").value =
        product.modal || 0;

    document.getElementById("productPrice").value =
        product.jual || 0;

    document.getElementById("productStock").value =
        product.stok || 0;

    document.getElementById("productMinStock").value =
        product.minStok || 0;


    openPage(
        "barang",
        document.querySelector('[data-page="barang"]')
    );

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });

};


window.deleteProduct = async function(id){

    if(!confirm("Hapus barang ini?")) return;

    try{

        await deleteDoc(
            doc(db,"barang",id)
        );

        await loadProducts();

    }catch(error){

        alert(error.message);

    }

};


window.loadProducts = async function(){

    try{

        const snapshot =
            await getDocs(
                collection(db,"barang")
            );


        products = [];

        snapshot.forEach(docSnap => {

            products.push({

                id:docSnap.id,

                ...docSnap.data()

            });

        });


        renderProducts();

        renderLowStock();

        document.getElementById("totalProducts")
            .textContent =
            products.length;

    }catch(error){

        console.error(error);

    }

};


function renderProducts(){

    const search =
        (
            document
                .getElementById("productSearch")
                ?.value || ""
        ).toLowerCase();


    const filtered =
        products.filter(p =>
            `${p.nama} ${p.barcode}`
                .toLowerCase()
                .includes(search)
        );


    const tbody =
        document.getElementById("productTable");


    tbody.innerHTML =
        filtered.map(p => `

<tr>

<td>
<b>${escapeHTML(p.nama)}</b>
</td>

<td>
${escapeHTML(p.barcode || "-")}
</td>

<td>
${formatRupiah(p.modal)}
</td>

<td>
${formatRupiah(p.jual)}
</td>

<td>

<span class="badge ${
    Number(p.stok) <= Number(p.minStok)
        ? "low"
        : ""
}">

${p.stok || 0}

</span>

</td>

<td>

<button
class="btn primary"
onclick="editProduct('${p.id}')">

Edit

</button>

<button
class="btn danger"
onclick="deleteProduct('${p.id}')">

Hapus

</button>

</td>

</tr>

`).join("");

}


// ======================================================
// STOK MENIPIS
// ======================================================

function renderLowStock(){

    const list =
        document.getElementById("lowStockList");


    const low =
        products.filter(
            p =>
                Number(p.stok || 0)
                <=
                Number(p.minStok || 0)
        );


    if(!low.length){

        list.innerHTML =
            "✅ Semua stok masih aman.";

        return;

    }


    list.innerHTML =
        low.map(p => `

<div style="padding:8px 0">

⚠️ <b>${escapeHTML(p.nama)}</b>

<br>

Stok:
${p.stok}

&nbsp; | &nbsp;

Minimum:
${p.minStok}

</div>

`).join("");

}


// ======================================================
// KASIR
// ======================================================

window.searchCashier = function(){

    const q =
        document
            .getElementById("cashierSearch")
            .value
            .toLowerCase();


    const result =
        products.filter(p =>
            `${p.nama} ${p.barcode}`
                .toLowerCase()
                .includes(q)
        )
        .slice(0,15);


    const box =
        document.getElementById("cashierResults");


    box.innerHTML =
        result.map(p => `

<div class="card">

<div style="display:flex;justify-content:space-between;align-items:center">

<div>

<b>
${escapeHTML(p.nama)}
</b>

<br>

${formatRupiah(p.jual)}

<br>

<small>
Stok: ${p.stok}
</small>

</div>

<button
class="btn primary"
onclick="addToCart('${p.id}')">

Tambah

</button>

</div>

</div>

`).join("");

};


window.addToCart = function(id){

    const product =
        products.find(p => p.id === id);

    if(!product) return;


    if(Number(product.stok) <= 0){

        alert("Stok barang habis.");

        return;

    }


    const existing =
        cart.find(c => c.id === id);


    if(existing){

        if(
            existing.qty
            >=
            Number(product.stok)
        ){

            alert("Jumlah melebihi stok.");

            return;

        }

        existing.qty++;

    }else{

        cart.push({
            id,
            qty:1
        });

    }


    renderCart();

};


function renderCart(){

    const box =
        document.getElementById("cartList");


    let total = 0;


    if(!cart.length){

        box.innerHTML =
            `<div class="empty">
            Keranjang masih kosong.
            </div>`;

        document.getElementById("cartTotal")
            .textContent =
            formatRupiah(0);

        return;

    }


    box.innerHTML =
        cart.map(item => {

            const p =
                products.find(x =>
                    x.id === item.id
                );


            if(!p) return "";


            const subtotal =
                Number(p.jual)
                *
                item.qty;


            total += subtotal;


            return `

<div class="cart-item">

<div>

<b>
${escapeHTML(p.nama)}
</b>

<br>

${formatRupiah(p.jual)}
× ${item.qty}

<br>

<b>
${formatRupiah(subtotal)}
</b>

</div>

<div>

<button
class="btn secondary"
onclick="changeCart('${p.id}',-1)">
−
</button>

<button
class="btn primary"
onclick="changeCart('${p.id}',1)">
+
</button>

</div>

</div>

`;

        }).join("");


    document.getElementById("cartTotal")
        .textContent =
        formatRupiah(total);

};


window.changeCart = function(id,change){

    const item =
        cart.find(c => c.id === id);

    if(!item) return;


    const product =
        products.find(p => p.id === id);


    item.qty += change;


    if(
        item.qty >
        Number(product.stok)
    ){

        item.qty =
            Number(product.stok);

    }


    if(item.qty <= 0){

        cart =
            cart.filter(c =>
                c.id !== id
            );

    }


    renderCart();

};


// ======================================================
// CHECKOUT
// ======================================================

window.checkout = async function(){

    if(!cart.length){

        alert("Keranjang kosong.");

        return;

    }


    const total =
        cart.reduce((sum,item)=>{

            const p =
                products.find(x =>
                    x.id === item.id
                );

            return sum +
                Number(p.jual)
                *
                item.qty;

        },0);


    const modal =
        cart.reduce((sum,item)=>{

            const p =
                products.find(x =>
                    x.id === item.id
                );

            return sum +
                Number(p.modal)
                *
                item.qty;

        },0);


    const laba =
        total - modal;


    try{

        await runTransaction(
            db,
            async transaction => {

                const items = [];


                for(const cartItem of cart){

                    const productRef =
                        doc(
                            db,
                            "barang",
                            cartItem.id
                        );


                    const productSnap =
                        await transaction.get(
                            productRef
                        );


                    if(!productSnap.exists()){

                        throw new Error(
                            "Barang tidak ditemukan."
                        );

                    }


                    const product =
                        productSnap.data();


                    if(
                        Number(product.stok)
                        <
                        cartItem.qty
                    ){

                        throw new Error(
                            `Stok ${product.nama} tidak cukup.`
                        );

                    }


                    transaction.update(
                        productRef,
                        {
                            stok:
                                Number(product.stok)
                                -
                                cartItem.qty,

                            updatedAt:
                                serverTimestamp()
                        }
                    );


                    items.push({

                        productId:
                            cartItem.id,

                        nama:
                            product.nama,

                        qty:
                            cartItem.qty,

                        modal:
                            Number(product.modal),

                        jual:
                            Number(product.jual)

                    });

                }


                const transactionRef =
                    doc(
                        collection(
                            db,
                            "transaksi"
                        )
                    );


                transaction.set(
                    transactionRef,
                    {

                        tanggal:
                            serverTimestamp(),

                        total,

                        modal,

                        laba,

                        items,

                        user:
                            auth.currentUser.email

                    }
                );

            }
        );


        alert(
            "✅ Transaksi berhasil!\n\n" +
            "Total: " +
            formatRupiah(total) +
            "\nLaba: " +
            formatRupiah(laba)
        );


        cart = [];

        await loadAll();

        renderCart();


    }catch(error){

        console.error(error);

        alert(
            "Transaksi gagal: " +
            error.message
        );

    }

};


// ======================================================
// SCANNER BARCODE
// ======================================================

window.startScanner = async function(){

    const video =
        document.getElementById("scannerVideo");

    const status =
        document.getElementById("scannerStatus");


    if(!("BarcodeDetector" in window)){

        status.innerHTML =
            "❌ Browser tidak mendukung BarcodeDetector. Gunakan Chrome Android terbaru atau masukkan barcode secara manual.";

        return;

    }


    try{

        const detector =
            new BarcodeDetector({

                formats:[
                    "ean_13",
                    "ean_8",
                    "upc_a",
                    "upc_e",
                    "code_128",
                    "code_39"
                ]

            });


        scannerStream =
            await navigator.mediaDevices
                .getUserMedia({

                    video:{
                        facingMode:{
                            ideal:"environment"
                        }
                    },

                    audio:false

                });


        video.srcObject =
            scannerStream;


        await video.play();


        scannerRunning = true;

        status.textContent =
            "📷 Kamera aktif. Arahkan ke barcode.";


        scanLoop(detector);


    }catch(error){

        console.error(error);

        status.textContent =
            "❌ Kamera tidak bisa digunakan: "
            + error.message;

    }

};


async function scanLoop(detector){

    if(!scannerRunning)
        return;


    const video =
        document.getElementById("scannerVideo");


    try{

        const barcodes =
            await detector.detect(video);


        if(barcodes.length){

            const code =
                barcodes[0].rawValue;


            handleBarcode(code);

            stopScanner();

            return;

        }

    }catch(error){

        console.log(error);

    }


    requestAnimationFrame(
        () => scanLoop(detector)
    );

}


window.stopScanner = function(){

    scannerRunning = false;


    if(scannerStream){

        scannerStream
            .getTracks()
            .forEach(track =>
                track.stop()
            );

        scannerStream = null;

    }


    const video =
        document.getElementById("scannerVideo");


    if(video){

        video.srcObject = null;

    }

};


async function handleBarcode(code){

    const result =
        document.getElementById("scanResult");


    const product =
        products.find(
            p => p.barcode === code
        );


    if(!product){

        result.innerHTML = `

<b>Barcode ditemukan:</b>

<br><br>

${escapeHTML(code)}

<br><br>

❌ Barang belum terdaftar.

<br><br>

<button
class="btn primary"
onclick="registerScannedBarcode('${escapeHTML(code)}')">

➕ Daftarkan Barang

</button>

`;

        return;

    }


    result.innerHTML = `

<h3>
${escapeHTML(product.nama)}
</h3>

Barcode:
${escapeHTML(product.barcode)}

<br><br>

💰 Modal:
<b>
${formatRupiah(product.modal)}
</b>

<br>

🏷️ Harga Jual:
<b>
${formatRupiah(product.jual)}
</b>

<br>

📦 Stok:
<b>
${product.stok}
</b>

<br>

📈 Laba:
<b>
${formatRupiah(
    Number(product.jual)
    -
    Number(product.modal)
)}
</b>

<br><br>

<button
class="btn success"
onclick="addToCart('${product.id}')">

🛒 Tambah ke Keranjang

</button>

`;

}


window.registerScannedBarcode =
function(code){

    openPage(
        "barang",
        document.querySelector(
            '[data-page="barang"]'
        )
    );


    document.getElementById(
        "productBarcode"
    ).value = code;

};


